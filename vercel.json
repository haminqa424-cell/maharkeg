{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "*.jpg", "use": "@vercel/static" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "download", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/admin/(.*)", "dest": "/api/index.js" },
    { "src": "/visit/(.*)", "dest": "/api/index.js" },
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/(.*\\.jpg)$", "dest": "/$1" },
    { "src": "/(.*\\.html)$", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/api/index.js" }
  ]
}
